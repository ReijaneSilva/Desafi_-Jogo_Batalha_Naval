#include <stdio.h>

#define TAMANHO 10
#define TAMANHO_NAVIO 3

int main() {
    int tabuleiro[TAMANHO][TAMANHO] = {0};

    // Navios horizontais/verticais
    int linha1 = 0, coluna1 = 0; // horizontal
    int linha2 = 3, coluna2 = 5; // vertical

    // Navios diagonais
    int linha3 = 6, coluna3 = 6; // diagonal principal
    int linha4 = 2, coluna4 = 7; // diagonal secundária

    // Horizontal
    for (int i = 0; i < TAMANHO_NAVIO; i++) {
        tabuleiro[linha1][coluna1 + i] = 3;
    }

    // Vertical
    for (int i = 0; i < TAMANHO_NAVIO; i++) {
        tabuleiro[linha2 + i][coluna2] = 3;
    }

    // Diagonal principal
    for (int i = 0; i < TAMANHO_NAVIO; i++) {
        tabuleiro[linha3 + i][coluna3 + i] = 3;
    }

    // Diagonal secundária
    for (int i = 0; i < TAMANHO_NAVIO; i++) {
        tabuleiro[linha4 + i][coluna4 - i] = 3;
    }

    // Exibe o tabuleiro
    printf("Tabuleiro - Nível Aventureiro:\n");
    for (int i = 0; i < TAMANHO; i++) {
        for (int j = 0; j < TAMANHO; j++) {
            printf("%d ", tabuleiro[i][j]);
        }
        printf("\n");
    }

    return 0;
}
